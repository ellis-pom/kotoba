# Port the server listens on (Render sets this automatically — you don't need to set it there)
PORT=3001

# Optional. Only needed for AI features (practice sentences, PDF extraction, grammar
# explanations, verb/adjective classification, translate-question quiz mixing).
# Get a free key at https://aistudio.google.com/app/apikey (no credit card required).
# Leave blank to run the app with everything except those features.
GEMINI_API_KEY=

# Optional. Leave both blank to use a local database file (the default — no Turso account
# needed). Set both to point the app at a real Turso database instead, e.g. for a live
# deployment where the local filesystem isn't durable (see README's Deploying section).
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=your-token-here
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional, and NOT the main access control — real accounts (register/log in from the app
# itself) already give each person their own private, isolated data. This is an extra OUTER
# layer: set BOTH to require a single shared username/password (a basic-auth browser prompt)
# before the site is reachable AT ALL — useful if you don't want the login/register page itself
# visible to random visitors on a public URL. Leave both blank for no outer gate (fine for
# localhost). Pick your own values.
SITE_USERNAME=
SITE_PASSWORD=
